# Configuración de la versión instalada del Asistente IA.
# APP_KEY y OPENAI_API_KEY los completa el instalador (php artisan jarvis:instalar).
APP_NAME="Asistente IA"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8073
APP_LOCALE=es
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=sqlite
SESSION_DRIVER=database
SESSION_LIFETIME=43200
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local
MAIL_MAILER=log

OPENAI_API_KEY=

# Sin pantalla de inicio de sesión: se entra directo con el usuario local.
JARVIS_ESCRITORIO=true
JARVIS_TRANSCRIPCION_EN_VIVO=true
INERTIA_DEVTOOLS_ENABLED=false
